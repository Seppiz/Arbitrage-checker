# ==========================================
# Telegram Bot Configuration
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_IDS=12345678,87654321
SUBSCRIBERS_FILE=subscribers.json

# ==========================================
# Exchange API Credentials
# ==========================================
# Nobitex Personal API Token (from Nobitex Profile -> API Key)
NOBITEX_API_TOKEN=your_nobitex_token_here

# Bitpin API Key (from Bitpin Profile -> API Key)
BITPIN_API_KEY=your_bitpin_api_key_here

# Wallex API Key (from Wallex Profile -> API Key)
WALLEX_API_KEY=your_wallex_api_key_here

# ==========================================
# Trading & Execution Settings
# ==========================================
# Safety Switch: Set to true for simulation mode, false for REAL trading!
DRY_RUN=true

# Capital per trade in USDT
TRADE_AMOUNT_USDT=100.0

# Minimum net profit (in USDT) required to execute a trade
MIN_PROFIT_USDT=0.20

# Minimum ROI percentage required to execute a trade (e.g. 0.35%)
MIN_ROI_PCT=0.35

# Maximum allowable price slippage percentage
MAX_SLIPPAGE_PCT=0.30

# Cooldown per symbol in seconds (prevents duplicate orders on the same spike)
TRADE_COOLDOWN_SECONDS=30

# ==========================================
# Exchange Fee Overrides (Percentages)
# ==========================================
NOBITEX_FEE_PCT=0.15
BITPIN_FEE_PCT=0.15
WALLEX_FEE_PCT=0.20
